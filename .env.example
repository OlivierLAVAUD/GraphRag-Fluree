# Copiez ce fichier en `.env` (ignoré par git) pour configurer la pile sans
# éditer docker-compose.yml. Toutes les variables sont optionnelles : les
# valeurs ci-dessous sont les défauts.

# --- Modèles Ollama ---------------------------------------------------------
# Un modèle 3B tient sur un GPU 6 Go avec le modèle d'embeddings ; un 8B
# déborde sur le CPU. Changer EMBED_MODEL impose de ré-indexer (dimension des
# vecteurs différente).
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# --- Graphe Fluree ----------------------------------------------------------
# Ne pas réutiliser le nom d'un ledger supprimé (« Ledger has been retracted »).
FLUREE_LEDGER=kb/main

# --- RAG --------------------------------------------------------------------
TOP_K=7
RETRIEVAL_MIN_SCORE=0.3
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Sécurité de l'API ------------------------------------------------------
# Si défini, `POST /api/chat`, `/api/search`, `/api/ingest`, `GET /api/sources`,
# `/api/entities` et `/api/history` exigent l'en-tête `X-API-Token: <valeur>`
# (ou `Authorization: Bearer <valeur>`). Laisser vide pour un usage local.
API_TOKEN=

# --- Limites ----------------------------------------------------------------
MAX_CONCURRENT_CHATS=2
MAX_UPLOAD_SIZE=52428800
MAX_TOTAL_UPLOAD_SIZE=209715200
MAX_UPLOAD_FILES=20
MAX_QUESTION_LENGTH=4000
MAX_TOP_K=50

# --- Cache de l'index de recherche ------------------------------------------
# Budget mémoire du cache (Mo). Au-delà, l'index n'est pas gardé en mémoire.
INDEX_CACHE_MAX_MB=256
INDEX_CACHE_MAX_ENTRIES=32
INDEX_CACHE_DIR=/tmp/graphrag-index-cache
